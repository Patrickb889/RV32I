00500093 // addi x1,  x0, 5             x1 = 5
00700113 // addi x2,  x0, 7             x2 = 7
002081b3 // add  x3,  x1, x2            x3 = 12
40110233 // sub  x4,  x2, x1            x4 = 2
0020f2b3 // and  x5,  x1, x2            x5 = 5
0020e333 // or   x6,  x1, x2            x6 = 7
0020a3b3 // slt  x7,  x1, x2            x7 = 1   (5 < 7 signed)
00113433 // sltu x8,  x2, x1            x8 = 0   (7 < 5 unsigned)
123454b7 // lui  x9,  0x12345           x9 = 0x12345000
67848493 // addi x9,  x9, 0x678         x9 = 0x12345678
00302023 // sw   x3,  0(x0)             mem[0] = 12
00002503 // lw   x10, 0(x0)             x10 = 12
00200423 // sb   x2,  8(x0)             mem byte @8 = 7
00804583 // lbu  x11, 8(x0)             x11 = 7
00108463 // beq  x1,  x1, +8            taken -> skip poison A
06f00a13 // addi x20, x0, 111           POISON A (must be skipped)
00100613 // addi x12, x0, 1             beq lands here, x12 = 1
00109463 // bne  x1,  x1, +8            NOT taken (x1 == x1)
02c00693 // addi x13, x0, 44            must execute, proves no skip, x13 = 44
0080076f // jal  x14, +8                x14 = link addr, jump -> skip poison B
0de00a93 // addi x21, x0, 222           POISON B (must be skipped)
00000797 // auipc x15, 0                jal lands here, x15 = own address
01078813 // addi x16, x15, 16           x16 = address of jalr landing point
000808e7 // jalr x17, 0(x16)            x17 = link addr, jump -> skip poison C
14d00b13 // addi x22, x0, 333           POISON C (must be skipped)
00900913 // addi x18, x0, 9             jalr lands here, x18 = 9